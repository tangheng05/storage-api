# Server
PORT=8080
PUBLIC_BASE_URL=https://media.example.com

# Shared upload key: any client that has this key may upload.
# Send it as header:  x-upload-key: <key>
UPLOAD_API_KEY=change-me-to-a-long-random-string

# Operator key for /moderation, deliberately separate from UPLOAD_API_KEY
# (which the main API and CI both hold). Unset disables those routes with a 503.
MODERATION_API_KEY=

# Storage directories (created automatically if missing)
TUS_DIR=./data/tus
JOBS_DIR=./data/jobs
VIDEOS_DIR=./data/videos
THUMBS_DIR=./data/thumbnails
AUDIO_DIR=./data/audio
IMAGES_DIR=./data/images

# Limits
MAX_UPLOAD_BYTES=2147483648
MAX_DURATION_SEC=14400
MAX_AUDIO_DURATION_SEC=14400
UPLOAD_EXPIRY_MS=86400000

# Images. MAX_UPLOAD_BYTES is sized for video, so images get their own (much
# smaller) cap, rejected at create time before any bytes are sent.
MAX_IMAGE_BYTES=20971520
# Long edge, in px. Larger uploads are downscaled to fit; smaller ones are
# never upscaled. Everything is published as WebP regardless of input format.
MAX_IMAGE_DIMENSION=2560
# Lossy quality for webp and jpeg output. PNG is lossless and ignores it.
IMAGE_QUALITY=82
# Decompression-bomb guard: refuse inputs above this many pixels (w*h).
MAX_IMAGE_PIXELS=100000000

# CORS (comma-separated). Supports exact origins, wildcard subdomains
# (https://*.example.com covers shop.example.com, blog.example.com, ...), or * for
# any origin. Communities on custom (third-party) domains need * or their
# own entry.
ALLOWED_ORIGINS=https://example.com,https://*.example.com

# Rate limit: max new uploads per IP per hour
CREATES_PER_HOUR=30

# Proxy hops in front of node (2 = Cloudflare + Nginx Proxy Manager).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=2

# Optional: path to ffmpeg/ffprobe binaries (defaults to PATH lookup)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Paywalled media (signed delivery) ------------------------------------
# Premium files live outside the directories nginx serves publicly and are
# reachable only via /media/... with a valid signature.
PRIVATE_VIDEOS_DIR=/var/www/serey-videos/private/videos
PRIVATE_AUDIO_DIR=/var/www/serey-videos/private/audio
PRIVATE_IMAGES_DIR=/var/www/serey-videos/private/images

# Must be byte-identical to MEDIA_SIGNING_SECRET in the main API, which signs,
# this service verifies. Generate with: openssl rand -hex 32
MEDIA_SIGNING_SECRET=


# In production nginx streams the file after this service authorizes the
# request, via the internal /internal-media location. Leave false locally.
USE_X_ACCEL=false
X_ACCEL_PREFIX=/internal-media

# --- Sia object storage -------------------------------------------------
# Off by default. With SIA_ENABLED=false nothing here is read, no network calls
# are made, and the service behaves exactly as it did before.
SIA_ENABLED=false
# From your Sia Storage account (sia.storage), s3d gateway.
SIA_S3_ENDPOINT=
SIA_S3_BUCKET=
SIA_S3_ACCESS_KEY=
SIA_S3_SECRET_KEY=
SIA_S3_REGION=us-east-1
# Set this and NEW uploads are served from Sia (e.g. https://cdn.example.com).
# Leave it empty and uploads are pushed to Sia purely as a backup while
# delivery stays on PUBLIC_BASE_URL. Existing media is never touched either
# way: those URLs are absolute and already stored in the main API.
SIA_PUBLIC_BASE_URL=
# Which media types go to Sia. Images first; add video,audio once proven.
SIA_MIRROR_TYPES=image
# Cap on unfinished mirrors retried per boot, so a long outage cannot crowd out
# live uploads.
PUBLISH_RECOVER_LIMIT=200

# --- S5: public media ----------------------------------------------------
# Public media only. A CID is the permission, so an S5 publish cannot be undone:
# premium stays on s3d, which has a private prefix and a working delete.
S5_ENABLED=false
# ghcr.io/s5-dev/node:latest behind a reverse proxy.
S5_NODE_URL=
# Mint one against the node. The account handshake is not implemented: the docs
# never state its request or response shape.
S5_AUTH_TOKEN=
# [http.api] domain in the node's config.toml. Defaults to S5_NODE_URL.
S5_DOWNLOAD_BASE_URL=
# Above this, uploads go over tus with the hash up front (reads the file twice).
S5_SMALL_MAX_BYTES=10485760
S5_TUS_CHUNK_BYTES=8388608
S5_TIMEOUT_MS=300000
# Rollout dial. Anything unlisted keeps using s3d.
S5_TYPES=image
# No documented unpin route, so a delete is best effort at most.
S5_UNPIN_ENABLED=false
# Default for uploads that express no preference: hold public media on local
# disk until POST /media/<kind>/<file>/promote is called, instead of pushing to
# S5 the moment the scan clears. An individual upload overrides this with the
# `defer_publish` tus metadata key, which is the better place to decide -- only
# the uploading surface knows whether a publish step is coming. Leave this
# false: a surface with no publish step would otherwise wait forever, and its
# files would never reach Sia at all.
S5_PROMOTE_ON_PUBLISH=false

# Show a client the CID of its own public media. A CID is a permanent public
# handle that cannot be withdrawn once shown, so this stays off until showing it
# is a deliberate decision.
S5_EXPOSE_CID=false

# --- S5 blob reads (required if S5 uses [store.s3]) -------------------------
# S5's S3 store reads every blob through a presigned URL. s3d authenticates on
# the Authorization header only, so it sees a query-signed request as anonymous
# and refuses it -- the node then hashes the 403 body and reports an integrity
# failure. Setting cdnUrls in the node's config.toml makes it fetch a plain URL
# instead, and this route is what that URL points at.
#
#   [store.s3]
#   cdnUrls = ["https://media.example.com/blob/"]     # trailing slash required
#
# The URL is signed and broadcast to S5 peers, so it must be the PUBLIC one:
# it is the address by which anyone else fetches these blobs by CID.
S5_BLOB_ENABLED=false
# Defaults to SIA_S3_ENDPOINT. Set it if premium keeps s3d switched off.
S5_BLOB_S3_ENDPOINT=
# S5's own bucket and key, not the mirror's: s3d scopes buckets to the user that
# created them, so the mirror's credentials cannot read what S5 wrote.
S5_BLOB_S3_BUCKET=media
S5_BLOB_S3_ACCESS_KEY=
S5_BLOB_S3_SECRET_KEY=
S5_BLOB_CACHE_SEC=31536000

# Our hostname, ULID in the path, CID resolved server-side. The main API freezes
# these into post rows permanently, so never put a raw CID or portal domain in
# one. Production: https://cdn.example.com (nginx maps / to /cdn/).
MEDIA_CDN_BASE_URL=
MEDIA_CDN_CACHE_SEC=86400

# --- Staging dirs (pre-scan) ---------------------------------------------
# Conversion output waits here for the scan gate. nginx must NOT serve these.
PENDING_VIDEOS_DIR=/var/www/serey-videos/pending/videos
PENDING_AUDIO_DIR=/var/www/serey-videos/pending/audio
PENDING_IMAGES_DIR=/var/www/serey-videos/pending/images
PENDING_THUMBS_DIR=/var/www/serey-videos/pending/thumbnails

# --- Content scanning ----------------------------------------------------
# The gate is at publication, not the storage push: exposure comes from serving
# the bytes, so a failed file must not be reachable anywhere.
SCAN_ENABLED=false
# Cheapest first. phash is local and free; http posts to your classifier.
SCAN_PROVIDERS=phash
SCAN_TIMEOUT_MS=30000
SCAN_BLOCKLIST_PATH=/var/www/serey-videos/blocklist.txt
# 0 is exact; 5 tolerates a re-encode or light crop.
SCAN_PHASH_DISTANCE=5
# Accepts {score}, {verdict} or {scores:{...}}, so most providers need no adapter.
SCAN_HTTP_URL=
SCAN_HTTP_KEY=
SCAN_HTTP_KEY_HEADER=authorization
# The single score, 0..1, at or above which an upload is refused. There is no
# review band and no moderation queue: nobody is holding borderline files, so
# they are refused and the uploader is told the category.
# NOTE: these are the OLD review thresholds. Raising them back to 0.9 publishes
# everything the old gate used to hold for a person.
SCAN_REJECT_SCORE=0.6
# Stricter for S5: that publish cannot be undone.
SCAN_REJECT_SCORE_IMMUTABLE=0.5
# Fail closed: a broken scanner holds the upload rather than publishing it.
# Verdict cache, keyed by perceptual hash.
#
# The classifier is not deterministic: the same file has scored 0.45 and 0.85 on
# consecutive uploads, either side of the threshold. Without this a retry is a
# re-roll -- a refused image gets through by being uploaded again, and a clean
# one fails for no reason the uploader can see. Remembering the first verdict
# per image is what makes the gate a decision instead of a dice throw.
#
# The TTL bounds a wrong answer in either direction; there is no review queue to
# appeal to, so a bad roll must not be permanent.
SCAN_CACHE_ENABLED=true
SCAN_CACHE_PATH=./data/scan-cache.json
SCAN_CACHE_TTL_SEC=86400
SCAN_CACHE_MAX=5000

SCAN_FAIL_OPEN=false
# How many scans run at once. The scan lane waits on a classifier and a storage
# node rather than the CPU, so 1 makes every uploader queue behind every other
# one. The ffmpeg and sharp lanes are unaffected and stay serial.
SCAN_CONCURRENCY=4

SCAN_RECOVER_LIMIT=200

# --- s3d hardening -------------------------------------------------------
# The SDK ships no request timeout and the publish lane is concurrency 1, so one
# hung socket would stall everything behind it.
SIA_S3_CONNECT_TIMEOUT_MS=10000
SIA_S3_REQUEST_TIMEOUT_MS=300000
# Set to when_required if s3d rejects the SDK's x-amz-checksum-crc32 header.
SIA_S3_CHECKSUMS=when_supported

# Google Cloud Vision SafeSearch. Plain API key, no SDK, 1000 images/month free.
# Enable the Vision API on the key or every call 403s. Add 'vision' to
# SCAN_PROVIDERS to turn it on.
SCAN_VISION_API_KEY=
# Only adult and violence by default. 'racy' fires on swimwear, tight clothing
# and a lot of ordinary photography; 'medical' on legitimate health content;
# 'spoof' just means "looks like a meme".
SCAN_VISION_CATEGORIES=adult,violence
# Frames sampled per video, spread across its duration. 1 scans only the
# generated thumbnail. Each extra frame is another classifier call.
SCAN_VIDEO_FRAMES=1

# Gemini, as an alternative to Vision. The image is scored against a
# responseSchema at temperature 0. Do NOT switch this to safetyRatings: those
# rate the model's own answer, not the input, and return the same NEGLIGIBLE for
# a gradient as for a weapon. An AI Studio key works as is, with no API to
# enable. Add 'gemini' to SCAN_PROVIDERS.
SCAN_GEMINI_API_KEY=
# 2.5 models think by default, which added ~30s to a call that returns three
# integers. 0 disables it. Use -1 to omit the field entirely for older models
# that reject it.
SCAN_GEMINI_THINKING_BUDGET=0
SCAN_GEMINI_MODEL=gemini-2.5-flash
# Of sexual / violence / weapons. 'weapons' is out on purpose: a legitimate
# photo of a firearm rates 100 there, and a gun in a picture is not a takedown
# reason on a social platform.
SCAN_GEMINI_CATEGORIES=sexual,violence

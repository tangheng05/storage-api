# Server
PORT=8080
PUBLIC_BASE_URL=https://storage.serey.io

# Shared upload key: any client that has this key may upload.
# Send it as header:  x-upload-key: <key>
UPLOAD_API_KEY=change-me-to-a-long-random-string

# Storage directories (created automatically if missing)
TUS_DIR=./data/tus
JOBS_DIR=./data/jobs
VIDEOS_DIR=./data/videos
THUMBS_DIR=./data/thumbnails

# Limits
MAX_UPLOAD_BYTES=2147483648
MAX_DURATION_SEC=14400
UPLOAD_EXPIRY_MS=86400000

# CORS (comma-separated). Use * to allow any origin.
ALLOWED_ORIGINS=https://serey.io,https://www.serey.io

# Rate limit: max new uploads per IP per hour
CREATES_PER_HOUR=30

# Proxy hops in front of node (2 = Cloudflare + Nginx Proxy Manager).
# Needed so rate limiting sees the real client IP.
TRUST_PROXY_HOPS=2

# Optional: path to ffmpeg/ffprobe binaries (defaults to PATH lookup)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
